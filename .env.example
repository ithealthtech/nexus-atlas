# Copy to .env and adjust. Never commit the real file.

# The address people use to reach Atlas (https in production).
PUBLIC_URL=https://atlas.example.com
# Used by Caddy to request the HTTPS certificate (docker compose only).
ATLAS_DOMAIN=atlas.example.com

# PostgreSQL. With docker compose, only POSTGRES_PASSWORD needs changing.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
DATABASE_URL=postgres://atlas:${POSTGRES_PASSWORD}@db:5432/atlas

# Master key protecting MFA secrets and (from M2) vault passwords: 32 random bytes, base64url.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Store a copy somewhere safe and separate from database backups. Without it, encrypted data cannot be recovered.
ATLAS_MASTER_KEY=

# Behind a reverse proxy (Caddy, IIS, nginx) so client addresses come from X-Forwarded-For.
TRUST_PROXY=true
LOG_LEVEL=info
