<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Company>MSP Atlas</Company>
    <Product>Atlas for Windows</Product>
    <!-- The app's own version, raised when the app changes (not with every Atlas release). Atlas tells signed-in
         copies which version it offers: keep WINDOWS_APP_VERSION in packages/shared/src/native.ts the same. -->
    <Version>0.3.3</Version>
  </PropertyGroup>
</Project>
