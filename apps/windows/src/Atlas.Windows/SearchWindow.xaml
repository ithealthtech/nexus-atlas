<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Atlas.Windows.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atlas.Windows"
    Title="Atlas">

    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <!-- The same navy as the web app's menu. -->
            <SolidColorBrush x:Key="RailBrush" Color="#1B273B" />
            <SolidColorBrush x:Key="RailHoverBrush" Color="#263449" />
            <SolidColorBrush x:Key="RailTextBrush" Color="#E7EBF0" />
            <SolidColorBrush x:Key="RailMutedBrush" Color="#9AA7B8" />
            <SolidColorBrush x:Key="AccentTileBrush" Color="#287AD2" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: search across the middle, the account on the right; the system keeps the window buttons. -->
        <TitleBar x:Name="AppTitleBar" Title="Atlas" Height="48">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE72E;" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <TextBox x:Name="QueryBox" MinWidth="320" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         PlaceholderText="Search all of Atlas   (Ctrl+F)" TextChanged="QueryBox_TextChanged" KeyDown="QueryBox_KeyDown"
                         AutomationProperties.Name="Search all of Atlas" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button x:Name="AccountButton" Background="Transparent" BorderThickness="0" Padding="6,4" Margin="0,0,8,0"
                        AutomationProperties.Name="Account">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentTileBrush}">
                            <TextBlock x:Name="AccountInitials" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="AccountName" IsEnabled="False" />
                            <MenuFlyoutItem x:Name="AccountServer" IsEnabled="False" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Open Atlas in your browser" Click="OpenAtlas_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Refresh" Click="Refresh_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="HelloMenu" Text="Windows Hello">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE928;" /></MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>

                            <MenuFlyoutItem x:Name="CheckUpdatesItem" Text="Check for updates" Click="CheckUpdates_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Sign out" Click="SignOut_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF3B1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Sign-in. -->
        <Grid x:Name="SetupPanel" Grid.Row="1" Visibility="Collapsed">
            <Border MaxWidth="460" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Sign in to Atlas" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Your browser opens so you can sign in the usual way, with your password and second step or a passkey. Atlas for Windows never sees your password." />
                    <TextBox x:Name="AddressBox" Header="Atlas address" PlaceholderText="https://atlas.example.com"
                             InputScope="Url" KeyDown="AddressBox_KeyDown" />
                    <InfoBar x:Name="SetupMessage" IsClosable="False" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="SignInButton" Style="{StaticResource AccentButtonStyle}" Content="Sign in with your browser"
                                Click="SignInButton_Click" />
                        <ProgressRing x:Name="SignInProgress" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Atlas: the sidebar, and one page at a time beside it. -->
        <!-- Shown instead of everything else while the app is locked. -->
        <Grid x:Name="LockPanel" Grid.Row="1" Visibility="Collapsed" Canvas.ZIndex="10" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="400">
                <FontIcon Glyph="&#xE72E;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Atlas is locked" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="LockReason" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="UnlockButton" Content="Unlock with Windows Hello" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="Unlock_Click" />
            </StackPanel>
        </Grid>
        <Grid x:Name="MainPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: the same places as the web app. -->
            <Grid Background="{StaticResource RailBrush}" Padding="10,12,10,10">
                <ListView x:Name="Sections" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Sections_ItemClick"
                          AutomationProperties.Name="Go to">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Section">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="2,6">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{StaticResource RailMutedBrush}" />
                                <TextBlock Text="{x:Bind Label}" Foreground="{StaticResource RailTextBrush}" FontSize="15" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                <!-- A newer version of this app, ready to install. -->
                <InfoBar x:Name="UpdateBar" Margin="20,12,24,0" IsOpen="False" Closed="UpdateBar_Closed">
                    <InfoBar.ActionButton>
                        <Button x:Name="UpdateButton" Content="Install and restart" Click="InstallUpdate_Click" Style="{StaticResource AccentButtonStyle}" />
                    </InfoBar.ActionButton>
                    <StackPanel Spacing="6" Margin="0,0,0,8">
                        <ProgressBar x:Name="UpdateProgress" Maximum="100" Visibility="Collapsed" />
                        <HyperlinkButton x:Name="UpdateBrowserLink" Content="Download it in your browser instead" Click="UpdateBrowser_Click" Padding="0" Visibility="Collapsed" />
                    </StackPanel>
                </InfoBar>
                <!-- Where you are, and the way back. -->
                <Grid Padding="20,14,24,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Click="Back_Click" Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <BreadcrumbBar x:Name="Crumbs" Grid.Column="1" VerticalAlignment="Center" ItemClicked="Crumbs_ItemClicked" />
                </Grid>
                </StackPanel>

                <!-- The page's title, and ways to narrow it down. -->
                <Grid Grid.Row="1" Padding="24,10,24,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PageInfo" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ToggleButton x:Name="ArchivedToggle" Click="ArchivedToggle_Click" Visibility="Collapsed" AutomationProperties.Name="Show archived">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                                <TextBlock Text="Archived" />
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="NewButton" Click="New_Click" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Name="NewText" Text="New password" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StarButton" Click="Star_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="StarIcon" Glyph="&#xE734;" FontSize="14" />
                                <TextBlock x:Name="StarText" Text="Add to favorites" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ComboBox x:Name="TypeFilter" Grid.Column="2" MinWidth="150" VerticalAlignment="Center" Visibility="Collapsed"
                              SelectionChanged="TypeFilter_SelectionChanged" AutomationProperties.Name="Asset type" />
                    <TextBox x:Name="FilterBox" Grid.Column="3" Width="240" VerticalAlignment="Center" PlaceholderText="Filter this list"
                             TextChanged="FilterBox_TextChanged" AutomationProperties.Name="Filter this list" />
                </Grid>

                <!-- A client's things, one kind per tab. -->
                <SelectorBar x:Name="Tabs" Grid.Row="2" Margin="18,0,24,4" Visibility="Collapsed" SelectionChanged="Tabs_SelectionChanged">
                    <SelectorBarItem x:Name="OverviewTab" Text="Overview" Tag="overview" />
                    <SelectorBarItem x:Name="PasswordsTab" Text="Passwords" Tag="passwords" />
                    <SelectorBarItem x:Name="AssetsTab" Text="Assets" Tag="assets" />
                    <SelectorBarItem x:Name="DocumentsTab" Text="Documents" Tag="documents" />
                </SelectorBar>

                <!-- A list page. -->
                <Grid x:Name="ListPanel" Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <ListView x:Name="Results" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Results_ItemClick"
                              AutomationProperties.Name="Items" Padding="12,4,12,12">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,0,12,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="local:RowGroup">
                                        <TextBlock Text="{x:Bind Key}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplateSelector>
                            <local:RowTemplates>
                                <local:RowTemplates.Plain>
                                    <DataTemplate x:DataType="local:Row">
                                        <Grid ColumnSpacing="14" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </local:RowTemplates.Plain>
                                <local:RowTemplates.Client>
                                    <DataTemplate x:DataType="local:Row">
                                        <Grid ColumnSpacing="12" Padding="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="8" Background="{x:Bind Facts.Tile}" VerticalAlignment="Top" Margin="0,2,0,0">
                                                <TextBlock Text="{x:Bind Facts.Initials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind Facts.StarVisibility}" VerticalAlignment="Center" />
                                                    <Border Visibility="{x:Bind Facts.StatusVisibility}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind Facts.Status}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Facts.Line}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Facts.Note}" FontSize="12" FontStyle="Italic" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind Facts.NoteVisibility}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="Passwords">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind Facts.PasswordsText}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="Assets">
                                                <FontIcon Glyph="&#xE7F8;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind Facts.AssetsText}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="Documents">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind Facts.DocumentsText}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Border Grid.Column="5" Visibility="{x:Bind Facts.AttentionVisibility}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{x:Bind Facts.AttentionBackground}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{x:Bind Facts.AttentionForeground}" />
                                                    <TextBlock Text="{x:Bind Facts.Attention}" FontSize="12" Foreground="{x:Bind Facts.AttentionForeground}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="5" Visibility="{x:Bind Facts.AllClearVisibility}" Text="Nothing due" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <FontIcon Grid.Column="6" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </local:RowTemplates.Client>
                                <local:RowTemplates.Item>
                                    <DataTemplate x:DataType="local:Row">
                                        <Grid ColumnSpacing="12" Padding="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="128" />
                                                <ColumnDefinition Width="128" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8" Background="{x:Bind Item.Tile}" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind Item.Glyph}" FontSize="16" Foreground="White" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <!-- The name gives way (with an ellipsis) before the star and chips do. -->
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind Item.StarVisibility}" VerticalAlignment="Center" />
                                                    <Border Visibility="{x:Bind Item.ChipAVisibility}" CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind Item.ChipA}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <Border Visibility="{x:Bind Item.ChipBVisibility}" CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind Item.ChipB}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Item.Line}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="3" Visibility="{x:Bind Item.BarsVisibility}">
                                                    <Border Width="12" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{x:Bind Item.Bar1}" />
                                                    <Border Width="12" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{x:Bind Item.Bar2}" />
                                                    <Border Width="12" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{x:Bind Item.Bar3}" />
                                                    <Border Width="12" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{x:Bind Item.Bar4}" />
                                                    <TextBlock Text="{x:Bind Item.State}" FontSize="12" Margin="6,0,0,0" Foreground="{x:Bind Item.StateForeground}" />
                                                </StackPanel>
                                                <Border Visibility="{x:Bind Item.PillVisibility}" CornerRadius="10" Padding="8,1" HorizontalAlignment="Left" Background="{x:Bind Item.StateBackground}">
                                                    <TextBlock Text="{x:Bind Item.State}" FontSize="12" Foreground="{x:Bind Item.StateForeground}" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Item.StateDetail}" FontSize="11" Foreground="{x:Bind Item.StateDetailForeground}" Visibility="{x:Bind Item.StateDetailVisibility}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Item.Due}" FontSize="12" Foreground="{x:Bind Item.DueForeground}" />
                                                <TextBlock Text="{x:Bind Item.DueDetail}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Item.Updated}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Item.UpdatedBy}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="5" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </local:RowTemplates.Item>
                            </local:RowTemplates>
                        </ListView.ItemTemplateSelector>
                        <!-- Column names over the Clients table, lined up with its rows. -->
                        <ListView.Header>
                            <StackPanel>
                            <Grid x:Name="ItemHeader" ColumnSpacing="12" Padding="12,6,12,4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="11" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ItemHeaderName" Grid.Column="1" Text="Name" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ItemHeaderState" Grid.Column="2" Text="Status" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ItemHeaderDue" Grid.Column="3" Text="Due" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="Updated" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Grid x:Name="ClientHeader" ColumnSpacing="12" Padding="12,6,12,4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="11" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Client" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="Passwords" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="Assets" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="Docs" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Text="Next 30 days" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            </StackPanel>
                        </ListView.Header>
                    </ListView>
                    <StackPanel x:Name="ListEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="24" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE721;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="ListEmptyText" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressBar x:Name="ListLoading" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" />
                </Grid>

                <!-- An item page. -->
                <ScrollViewer x:Name="DetailScroll" Grid.Row="3" Padding="24,8,24,24" Visibility="Collapsed">
                    <StackPanel x:Name="Detail" MaxWidth="760" HorizontalAlignment="Left" />
                </ScrollViewer>
                
                <Border x:Name="DetailBar" Grid.Row="4" Visibility="Collapsed" Padding="24,10"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EditHereButton" Click="EditHere_Click" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ConnectButton" Click="Connect_Click" Visibility="Collapsed" AutomationProperties.AutomationId="ConnectButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                                <TextBlock x:Name="ConnectText" Text="Connect" />
                            </StackPanel>
                        </Button>
                        <Button Click="Edit_Click" AutomationProperties.Name="Open in Atlas">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                <TextBlock Text="Open in Atlas" />
                            </StackPanel>
                        </Button>
                        <Button Click="CopyLink_Click" AutomationProperties.Name="Copy link">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                <TextBlock Text="Copy link" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RestoreButton" Click="Restore_Click" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock Text="Restore" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ArchiveButton" Click="Archive_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                                <TextBlock Text="Archive" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <InfoBar x:Name="StatusBar" Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" IsClosable="True" MaxWidth="480" />
            </Grid>
        </Grid>
    </Grid>
</Window>
