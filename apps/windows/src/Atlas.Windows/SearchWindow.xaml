<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Atlas.Windows.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atlas.Windows"
    Title="Atlas">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- The same navy as the web app's menu. -->
            <SolidColorBrush x:Key="RailBrush" Color="#1B273B" />
            <SolidColorBrush x:Key="RailHoverBrush" Color="#263449" />
            <SolidColorBrush x:Key="RailTextBrush" Color="#E7EBF0" />
            <SolidColorBrush x:Key="RailMutedBrush" Color="#9AA7B8" />
            <SolidColorBrush x:Key="AccentTileBrush" Color="#287AD2" />
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: drawn by the app so it matches the sidebar; the system keeps the window buttons. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource RailBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource AccentTileBrush}">
                    <TextBlock Text="A" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Atlas" Foreground="{StaticResource RailTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TitleOrg" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Sign-in. -->
        <Grid x:Name="SetupPanel" Grid.Row="1" Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}" MaxWidth="460" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="14">
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentTileBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="A" FontWeight="Bold" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Sign in to Atlas" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Your browser opens so you can sign in the usual way, with your password and second step or a passkey. Atlas for Windows never sees your password." />
                    <TextBox x:Name="AddressBox" Header="Atlas address" PlaceholderText="https://atlas.example.com"
                             InputScope="Url" KeyDown="AddressBox_KeyDown" />
                    <InfoBar x:Name="SetupMessage" IsClosable="False" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="SignInButton" Style="{StaticResource AccentButtonStyle}" Content="Sign in with your browser"
                                Click="SignInButton_Click" />
                        <ProgressRing x:Name="SignInProgress" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The vault: what to look at, the list, and the item. -->
        <Grid x:Name="SearchPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" MinWidth="260" MaxWidth="360" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Background="{StaticResource RailBrush}" Padding="10,4,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView x:Name="Sections" SelectionMode="Single" SelectionChanged="Sections_SelectionChanged"
                          AutomationProperties.Name="Show">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Section">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="2,8">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{StaticResource RailMutedBrush}" />
                                <TextBlock Text="{x:Bind Label}" Foreground="{StaticResource RailTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Text="Clients" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RailMutedBrush}" Margin="14,18,0,6" />
                <TextBox x:Name="ClientFilter" Grid.Row="2" PlaceholderText="Filter clients" Margin="4,0,4,6"
                         TextChanged="ClientFilter_TextChanged" AutomationProperties.Name="Filter clients" />
                <ListView x:Name="ClientList" Grid.Row="3" SelectionMode="Single" SelectionChanged="ClientList_SelectionChanged"
                          AutomationProperties.Name="Clients">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ClientChoice">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,5">
                                <Border Width="24" Height="24" CornerRadius="5" Background="{StaticResource RailHoverBrush}">
                                    <TextBlock Text="{x:Bind Initials}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource RailTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource RailTextBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" MaxWidth="160" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="AccountButton" Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="8" Margin="0,8,0,0"
                        AutomationProperties.Name="Account">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource RailHoverBrush}">
                            <TextBlock x:Name="AccountInitials" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RailTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="AccountName" Foreground="{StaticResource RailTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                            <TextBlock x:Name="AccountServer" Foreground="{StaticResource RailMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                        </StackPanel>
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Open Atlas in your browser" Click="OpenAtlas_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Refresh" Click="Refresh_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Sign out" Click="SignOut_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF3B1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- The list -->
            <Grid Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="QueryBox" Margin="16,14,16,10" PlaceholderText="Search Atlas   (Ctrl+F)"
                         TextChanged="QueryBox_TextChanged" KeyDown="QueryBox_KeyDown" AutomationProperties.Name="Search Atlas" />
                <Grid Grid.Row="1" Margin="18,2,16,8">
                    <TextBlock x:Name="ListTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,40,0" />
                    <TextBlock x:Name="ListCount" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView x:Name="Results" Grid.Row="2" SelectionMode="Single" SelectionChanged="Results_SelectionChanged"
                          KeyDown="Results_KeyDown" DoubleTapped="Results_DoubleTapped" AutomationProperties.Name="Items"
                          Padding="6,0,6,6">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Row">
                            <Grid ColumnSpacing="12" Padding="2,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="ListEmpty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="24" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE721;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="ListEmptyText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ProgressBar x:Name="ListLoading" Grid.Row="1" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="Collapsed" Margin="16,0" />
            </Grid>

            <!-- The item -->
            <Grid Grid.Column="2">
                <ScrollViewer x:Name="DetailScroll" Padding="28,22,28,28">
                    <StackPanel x:Name="Detail" MaxWidth="640" HorizontalAlignment="Stretch" />
                </ScrollViewer>
                <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8A1;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Choose something on the left to see it here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Ctrl+Shift+Space opens Atlas from anywhere." HorizontalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <InfoBar x:Name="StatusBar" VerticalAlignment="Bottom" Margin="20" IsClosable="True" MaxWidth="560" />
            </Grid>
        </Grid>
    </Grid>
</Window>
