<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Atlas.Windows.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Atlas.Windows.Core"
    Title="Atlas">

    <Grid x:Name="Root" Padding="16" KeyDown="Root_KeyDown">
        <!-- Sign-in: the Atlas address, then the browser does the rest. -->
        <StackPanel x:Name="SetupPanel" Spacing="12" MaxWidth="440" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Sign in to Atlas" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Your browser opens so you can sign in the usual way, with your password and second step or a passkey. Atlas for Windows never sees your password." />
            <TextBox x:Name="AddressBox" Header="Atlas address" PlaceholderText="https://atlas.example.com"
                     InputScope="Url" KeyDown="AddressBox_KeyDown" />
            <InfoBar x:Name="SetupMessage" IsClosable="False" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SignInButton" Style="{StaticResource AccentButtonStyle}" Content="Sign in with your browser"
                        Click="SignInButton_Click" />
                <ProgressRing x:Name="SignInProgress" IsActive="False" Width="20" Height="20" />
            </StackPanel>
        </StackPanel>

        <!-- Quick search: results on the left, a read-only summary and actions on the right. -->
        <Grid x:Name="SearchPanel" RowSpacing="12" ColumnSpacing="16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueryBox" Grid.ColumnSpan="2" PlaceholderText="Search clients, assets, documents, and passwords"
                     TextChanged="QueryBox_TextChanged" KeyDown="QueryBox_KeyDown" FontSize="18"
                     AutomationProperties.Name="Search Atlas" />

            <ListView x:Name="Results" Grid.Row="1" SelectionMode="Single" SelectionChanged="Results_SelectionChanged"
                      KeyDown="Results_KeyDown" DoubleTapped="Results_DoubleTapped" AutomationProperties.Name="Results">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:SearchResult">
                        <StackPanel Padding="0,6">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Row="1" Grid.Column="1">
                <StackPanel x:Name="Detail" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailKind" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailBody" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Spacing="6" Margin="0,8,0,0">
                        <Button x:Name="CopyPasswordButton" Content="Copy password" Click="CopyPassword_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="CopyCodeButton" Content="Copy one-time code" Click="CopyCode_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="CopyUsernameButton" Content="Copy username" Click="CopyUsername_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="OpenSignInButton" Content="Open sign-in address" Click="OpenSignIn_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="OpenWebButton" Content="Open in Atlas" Click="OpenWeb_Click" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <InfoBar x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="2" IsClosable="True" />
        </Grid>
    </Grid>
</Window>
