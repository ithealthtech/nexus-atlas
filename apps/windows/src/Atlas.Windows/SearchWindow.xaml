<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Atlas.Windows.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atlas.Windows"
    Title="Atlas">

    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <!-- Atlas blue, as in the web app. The sidebar is solid blue with white text. -->
            <SolidColorBrush x:Key="BrandBrush" Color="#1F64B8" />
            <SolidColorBrush x:Key="BrandDarkBrush" Color="#18518F" />
            <SolidColorBrush x:Key="OnBrandBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OnBrandMutedBrush" Color="#C9DDF4" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: search across the middle, the account on the right; the system keeps the window buttons. -->
        <TitleBar x:Name="AppTitleBar" Title="Atlas" Height="48" Background="{StaticResource BrandDarkBrush}"
                  Foreground="{StaticResource OnBrandBrush}">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE72E;" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <TextBox x:Name="QueryBox" MinWidth="320" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         PlaceholderText="Search Atlas   (Ctrl+F)" TextChanged="QueryBox_TextChanged" KeyDown="QueryBox_KeyDown"
                         AutomationProperties.Name="Search Atlas" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button x:Name="AccountButton" Background="Transparent" BorderThickness="0" Padding="6,4" Margin="0,0,8,0"
                        AutomationProperties.Name="Account">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrandBrush}">
                            <TextBlock x:Name="AccountInitials" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnBrandBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource OnBrandMutedBrush}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="AccountName" IsEnabled="False" />
                            <MenuFlyoutItem x:Name="AccountServer" IsEnabled="False" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Open Atlas in your browser" Click="OpenAtlas_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Refresh" Click="Refresh_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Sign out" Click="SignOut_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF3B1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Sign-in. -->
        <Grid x:Name="SetupPanel" Grid.Row="1" Visibility="Collapsed">
            <Border MaxWidth="460" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Sign in to Atlas" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Your browser opens so you can sign in the usual way, with your password and second step or a passkey. Atlas for Windows never sees your password." />
                    <TextBox x:Name="AddressBox" Header="Atlas address" PlaceholderText="https://atlas.example.com"
                             InputScope="Url" KeyDown="AddressBox_KeyDown" />
                    <InfoBar x:Name="SetupMessage" IsClosable="False" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="SignInButton" Style="{StaticResource AccentButtonStyle}" Content="Sign in with your browser"
                                Click="SignInButton_Click" />
                        <ProgressRing x:Name="SignInProgress" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The vault. -->
        <NavigationView x:Name="Nav" Grid.Row="1" Visibility="Collapsed" PaneDisplayMode="Left" OpenPaneLength="232"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="True"
                        SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="Show">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#1F64B8" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#1F64B8" />
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#1F64B8" />
                <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#2B74C8" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#18518F" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#18518F" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#C9DDF4" />
                <SolidColorBrush x:Key="NavigationViewButtonForeground" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#4F86C9" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="All items" Tag="all" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="favorites">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Recent" Tag="recent">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Types" />
                <NavigationViewItem Content="Passwords" Tag="passwords">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Assets" Tag="assets">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE977;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Documents" Tag="documents">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Clients" />
                <NavigationViewItem x:Name="ClientsItem" Content="Clients" SelectsOnInvoked="False" IsExpanded="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE821;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- List, and the item. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="250" MaxWidth="340" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Grid Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,12,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ListTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ListCount" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="TypeFilter" Grid.Column="1" MinWidth="120" MaxWidth="160" Visibility="Collapsed"
                                  SelectionChanged="TypeFilter_SelectionChanged" AutomationProperties.Name="Asset type" />
                    </Grid>
                    <ProgressBar x:Name="ListLoading" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="Collapsed" Margin="12,0" />
                    <ListView x:Name="Results" Grid.Row="1" SelectionMode="Single" SelectionChanged="Results_SelectionChanged"
                              KeyDown="Results_KeyDown" DoubleTapped="Results_DoubleTapped" AutomationProperties.Name="Items"
                              Padding="0,0,0,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="40" />
                                <Setter Property="Padding" Value="12,0,8,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="local:RowGroup">
                                        <TextBlock Text="{x:Bind Key}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Row">
                                <Grid ColumnSpacing="10" Padding="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="ListEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="24" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE721;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="ListEmptyText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="DetailScroll" Padding="24,18,24,24">
                        <StackPanel x:Name="Detail" MaxWidth="680" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                    <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE8A1;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Choose something on the left to see it here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Ctrl+Shift+Space opens Atlas from anywhere." HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <!-- Actions for the item, along the bottom as in a desktop vault. -->
                    <Border x:Name="DetailBar" Grid.Row="1" Visibility="Collapsed" Padding="16,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="EditButton" Click="Edit_Click" ToolTipService.ToolTip="Edit in Atlas" AutomationProperties.Name="Edit in Atlas">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    <TextBlock Text="Edit in Atlas" />
                                </StackPanel>
                            </Button>
                            <Button Click="CopyLink_Click" ToolTipService.ToolTip="Copy a link to this in Atlas" AutomationProperties.Name="Copy link">
                                <FontIcon Glyph="&#xE71B;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <InfoBar x:Name="StatusBar" VerticalAlignment="Bottom" Margin="20,20,20,64" IsClosable="True" MaxWidth="560" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
