<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 app: tray, global hotkey, quick search, and copy actions. Builds on Windows only. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Atlas.Windows</RootNamespace>
    <AssemblyName>AtlasForWindows</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Packaged as MSIX (Package.appxmanifest). Signing and the update feed are configured at release time. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Generated XAML code and WinRT interop raise analyzer warnings we don't control; keep them visible, not fatal. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The window and app live as long as the process; there is nothing to dispose them into. -->
    <NoWarn>$(NoWarn);CA1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\Tray.ico" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Atlas.Windows.Core\Atlas.Windows.Core.csproj" />
  </ItemGroup>
</Project>
